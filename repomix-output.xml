name: Keep Render App Awake

on:
  schedule:
    # Runs every 14 minutes. 
    # Render puts apps to sleep after 15 minutes of inactivity.
    # GitHub's minimum is 5 minutes, so we use 14 to be safe.
    - cron: '*/14 * * * *'
  workflow_dispatch: # Allows you to run it manually from the Actions tab

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Render App Health Endpoint
        run: |
          # Replace the URL below with your actual Render URL
          URL="https://YOUR-RENDER-URL-HERE.onrender.com/healthz"
          echo "Pinging $URL ..."
          curl -s -o /dev/null -w "HTTP Status: %{http_code}\nResponse Time: %{time_total}s\n" "$URL"
