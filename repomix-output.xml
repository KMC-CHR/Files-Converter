   <script>
    lucide.createIcons();

    // Strict batch limits per mode to prevent memory overflow and API blocks
    const BATCH_LIMITS = {
        'convert': 10,
        'upscale': 5,
        'ai-upscale': 3,
        'enhance': 5
    };

    const queues = {
        'convert': [],
        'upscale': [],
        'ai-upscale': [],
        'enhance': []
    };

    function switchTab(tabName, evt) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

        if (evt && evt.currentTarget) {
            evt.currentTarget.classList.add('active');
        }
        document.getElementById('panel-' + tabName).classList.add('active');
    }

    // Prevent default browser drag-over behavior
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        window.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
        }, false);
    });

    function setupDropZone(dropZoneId, inputId, mode) {
        const zone = document.getElementById(dropZoneId);
        if (!zone) return;

        ['dragenter', 'dragover'].forEach(eventName => {
            zone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                zone.classList.add('drag-active');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            zone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                zone.classList.remove('drag-active');
            }, false);
        });

        zone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length > 0) {
                addFilesToQueue(dt.files, mode);
            }
        }, false);
    }

    document.addEventListener('DOMContentLoaded', () => {
        setupDropZone('drop-zone-convert', 'file-input-convert', 'convert');
        setupDropZone('drop-zone-upscale', 'file-input-upscale', 'upscale');
        setupDropZone('drop-zone-ai-upscale', 'file-input-ai-upscale', 'ai-upscale');
        setupDropZone('drop-zone-enhance', 'file-input-enhance', 'enhance');
    });

    function addFilesToQueue(files, mode) {
        if (!files || files.length === 0) return;

        const maxLimit = BATCH_LIMITS[mode] || 5;
        const currentCount = queues[mode].length;
        const remainingSlots = maxLimit - currentCount;

        if (remainingSlots <= 0) {
            alert(`Queue limit reached. Maximum ${maxLimit} files allowed at once for ${mode}.`);
            return;
        }

        let defaultFormat = 'png';
        const batchSelect = document.getElementById(`batch-format-${mode}`);
        if (batchSelect) defaultFormat = batchSelect.value;

        // Add files up to allowed remaining slots
        const filesToAdd = Array.from(files).slice(0, remainingSlots);
        if (files.length > remainingSlots) {
            alert(`Added ${remainingSlots} file(s). Exceeded maximum batch limit of ${maxLimit} files for this tab.`);
        }

        for (let file of filesToAdd) {
            queues[mode].push({
                id: Math.random().toString(36).substring(2, 9),
                file: file,
                format: defaultFormat,
                status: 'Ready'
            });
        }

        renderQueueUI(mode);
    }

    function removeQueueItem(mode, id) {
        queues[mode] = queues[mode].filter(item => item.id !== id);
        renderQueueUI(mode);
    }

    function clearQueue(mode) {
        queues[mode] = [];
        renderQueueUI(mode);
    }

    function updateItemFormat(mode, id, format) {
        const item = queues[mode].find(i => i.id === id);
        if (item) item.format = format;
    }

    function updateAllFormats(mode, format) {
        queues[mode].forEach(item => item.format = format);
        renderQueueUI(mode);
    }

    function renderQueueUI(mode) {
        const emptyZone = document.getElementById(`drop-zone-${mode}`);
        const queueContainer = document.getElementById(`queue-container-${mode}`);
        const itemsList = document.getElementById(`file-list-${mode}`);
        const summaryText = document.getElementById(`queue-summary-${mode}`);
        const maxLimit = BATCH_LIMITS[mode] || 5;

        if (queues[mode].length === 0) {
            emptyZone.style.display = 'flex';
            queueContainer.style.display = 'none';
            return;
        }

        emptyZone.style.display = 'none';
        queueContainer.style.display = 'block';

        let totalBytes = queues[mode].reduce((acc, curr) => acc + curr.file.size, 0);
        let totalMB = (totalBytes / (1024 * 1024)).toFixed(2);
        summaryText.textContent = `${queues[mode].length}/${maxLimit} File(s) • ${totalMB} MB`;

        itemsList.innerHTML = '';

        queues[mode].forEach(item => {
            const mbSize = (item.file.size / (1024 * 1024)).toFixed(2);
            const itemEl = document.createElement('div');
            itemEl.className = 'file-queue-item';

            let actionBadge = '';
            if (item.status === 'Ready') {
                actionBadge = `<span class="badge badge-ready">Ready</span>`;
            } else if (item.status === 'Processing') {
                actionBadge = `<span class="badge badge-busy">Processing...</span>`;
            } else if (item.status === 'Done') {
                actionBadge = `<span class="badge badge-success">Downloaded</span>`;
            } else {
                actionBadge = `<span class="badge badge-error">Failed</span>`;
            }

            const hideFormatSelector = mode === 'ai-upscale';

            itemEl.innerHTML = `
                <div class="file-item-left">
                    <i data-lucide="image" class="file-icon"></i>
                    <div class="file-info">
                        <span class="file-name" title="${item.file.name}">${item.file.name}</span>
                        <span class="file-size">${mbSize} MB</span>
                    </div>
                </div>
                <div class="file-item-right">
                    ${actionBadge}
                    ${!hideFormatSelector ? `
                    <select class="native-styled-select select-compact" onchange="updateItemFormat('${mode}', '${item.id}', this.value)" ${item.status === 'Processing' ? 'disabled' : ''}>
                        <option value="png" ${item.format === 'png' ? 'selected' : ''}>PNG</option>
                        <option value="jpg" ${item.format === 'jpg' ? 'selected' : ''}>JPG</option>
                        <option value="webp" ${item.format === 'webp' ? 'selected' : ''}>WEBP</option>
                    </select>
                    ` : ''}
                    <button class="btn-remove-item" onclick="removeQueueItem('${mode}', '${item.id}')">
                        <i data-lucide="x"></i>
                    </button>
                </div>
            `;
            itemsList.appendChild(itemEl);
        });

        lucide.createIcons();
    }

    // Triggers immediate browser download without manual clicks
    function triggerAutoDownload(blob, filename) {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.style.display = 'none';
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        
        setTimeout(() => {
            a.remove();
            window.URL.revokeObjectURL(url);
        }, 1000);
    }

    // Batch process with auto-downloading upon completion
    async function processBatch(mode, retryCount = 0) {
        const btn = document.getElementById(`btn-process-${mode}`);
        if (btn) btn.disabled = true;

        for (let item of queues[mode]) {
            if (item.status === 'Done') continue;

            item.status = 'Processing';
            renderQueueUI(mode);

            const formData = new FormData();
            formData.append('file', item.file);

            let endpoint = '/convert-single';
            if (mode === 'upscale') {
                endpoint = '/upscale-single';
                formData.append('target_res', document.getElementById('target-res').value);
                formData.append('target_format', item.format);
                formData.append('resample', document.getElementById('resample-filter').value);
            } else if (mode === 'ai-upscale') {
                endpoint = '/ai-upscale-single';
            } else if (mode === 'enhance') {
                endpoint = '/enhance-single';
                formData.append('enhance_mode', document.getElementById('enhance-mode').value);
                formData.append('target_format', item.format);
            } else {
                formData.append('target_format', item.format);
            }

            try {
                const response = await fetch(endpoint, { method: 'POST', body: formData });

                if (response.status === 503 && retryCount < 3) {
                    await new Promise(res => setTimeout(res, 4000));
                    return processBatch(mode, retryCount + 1);
                }

                if (!response.ok) throw new Error('Processing failed');

                const blob = await response.blob();
                const outputName = `${mode}_${osFilenameWithoutExt(item.file.name)}.${mode === 'ai-upscale' ? 'png' : item.format}`;
                
                // Automatically download immediately
                triggerAutoDownload(blob, outputName);
                
                item.status = 'Done';
            } catch (err) {
                item.status = 'Error';
            }
            renderQueueUI(mode);
        }

        if (btn) btn.disabled = false;
    }

    function osFilenameWithoutExt(filename) {
        return filename.substring(0, filename.lastIndexOf('.')) || filename;
    }
</script>
